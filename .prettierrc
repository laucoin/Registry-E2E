{
	"printWidth": 120,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSpacing": true,
	"arrowParens": "always",
	"overrides": [
		{
			"files": ["*.ts", "*.css", "*.scss"],
			"options": {
				"tabWidth": 4
			}
		},
		{
			"files": ["*.html"],
			"options": {
				"tabWidth": 2
			}
		}
	]
}
