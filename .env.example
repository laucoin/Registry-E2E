# Seeded test-IdP user — local dev: the spike test account.
# Four secondary accounts are derived from this username by the Authentik
# blueprint and share E2E_PASSWORD, so nothing extra needs configuring here:
#   <user>-member  global USER — the lesser actor every refusal is asserted against
#   <user>-fresh   unseeded — first-sign-in auto-provisioning
#   <user>-clash   shares the admin's email — AUTH_EMAIL_ALREADY_USED
#   <user>-burn    the anonymization target
E2E_USERNAME= # FIXME
E2E_PASSWORD= # FIXME
# E2E_EMAIL=e2e@example.test
# Authentik App-password token (intent app_password) for the setup/teardown
# project cleanup — Authentik's password grant is not classic ROPC, so the
# login password does not work here. Leave empty to skip cleanup.
E2E_CLEANUP_TOKEN= # FIXME
# E2E_NUXT_URL=http://localhost:3000
# Short-session Nuxt instance for the session-lifetime journeys only. Leave unset
# locally: the `nuxt-session` project skips itself when the instance is absent.
# E2E_NUXT_SESSION_URL=http://localhost:3001
# E2E_BACKEND_URL=http://localhost:8081
# IdP is Authentik (see Registry-Backend/local-dev/compose.yml). The issuer is
# the application's OIDC URL; the token endpoint is derived from its origin.
# E2E_ISSUER=http://localhost:9000/application/o/registry
# E2E_TOKEN_URL=http://localhost:9000/application/o/token/
# E2E_TEST_CLIENT=registry-test-cli
