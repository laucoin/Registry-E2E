{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"@components/*": ["./components/*"],
			"@fixtures/*": ["./fixtures/*"],
			"@pages/*": ["./pages/*"],
			"@support/*": ["./support/*"]
		}
	},
	"include": ["*.ts", "components", "fixtures", "pages", "specs", "support"]
}
